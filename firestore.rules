rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Check if the current user is a parent in the specified family
    function isParent(familyId) {
      return isSignedIn() && get(/databases/$(database)/documents/families/$(familyId)/users/$(request.auth.uid)).data.role == 'parent';
    }

    // --- Family Rules ---
    match /families/{familyId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidId(familyId) &&
        incoming().keys().hasAll(['id', 'name', 'createdBy', 'createdAt']) &&
        incoming().id == familyId &&
        incoming().createdBy == request.auth.uid;
    }

    // --- User Rules ---
    match /families/{familyId}/users/{userId} {
      function isValidUser(data) {
        return data.keys().hasAll(['uid', 'name', 'role', 'points', 'familyId', 'avatarUrl']) &&
               data.uid == userId &&
               data.familyId == familyId &&
               data.role in ['parent', 'kid'] &&
               data.points is number &&
               data.name is string && data.name.size() <= 100;
      }

      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidUser(incoming());
      allow update: if isSignedIn() && (
        // Allow parents to update anything (like points)
        isParent(familyId) ||
        // Allow the user themselves to update points (spending for goals) or avatar
        (request.auth.uid == userId && incoming().diff(existing()).affectedKeys().hasAny(['points', 'avatarUrl']))
      ) && isValidUser(incoming());
    }

    // --- Chore Rules ---
    match /families/{familyId}/chores/{choreId} {
      allow read: if isSignedIn();
      allow create: if isParent(familyId);
      allow update: if isParent(familyId);
      allow delete: if isParent(familyId);
    }

    // --- Completion Rules ---
    match /families/{familyId}/completions/{completionId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && incoming().kidId == request.auth.uid;
      allow update: if isParent(familyId) && incoming().diff(existing()).affectedKeys().hasOnly(['status']);
    }

    // --- Reward Rules ---
    match /families/{familyId}/rewards/{rewardId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isParent(familyId);
    }

    // --- Redemption Rules ---
    match /families/{familyId}/redemptions/{redemptionId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && incoming().kidId == request.auth.uid;
      allow update: if isParent(familyId) && incoming().diff(existing()).affectedKeys().hasOnly(['status']);
    }

    // --- Shared Goal Rules ---
    match /families/{familyId}/shared-goals/{goalId} {
      allow read: if isSignedIn();
      allow create: if isParent(familyId);
      allow update: if isSignedIn() && (
        isParent(familyId) ||
        // Allow contribution to currentPoints and specific contributor key
        incoming().diff(existing()).affectedKeys().hasAny(['currentPoints', 'contributors'])
      );
      allow delete: if isParent(familyId);
    }

    // --- Notification Rules ---
    match /families/{familyId}/notifications/{notifId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn() && request.auth.uid == existing().userId && incoming().diff(existing()).affectedKeys().hasOnly(['read']);
    }
  }
}
