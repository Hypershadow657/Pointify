rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Common helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Family Rules
    match /families/{familyId} {
      allow read: if true; // Publicly readable by ID to join
      allow create: if isSignedIn() && 
        request.resource.data.keys().hasAll(['id', 'name', 'createdBy', 'createdAt']) &&
        request.resource.data.id == familyId;
    }

    // User Rules
    match /families/{familyId}/users/{userId} {
      allow read: if true; // Members can see each other
      allow create, update: if isSignedIn() && 
        request.resource.data.familyId == familyId;
    }

    // Chore Rules
    match /families/{familyId}/chores/{choreId} {
      allow read: if true;
      allow create, update, delete: if isSignedIn();
    }

    // Completion Rules
    match /families/{familyId}/completions/{completionId} {
      allow read: if true;
      allow create, update: if isSignedIn();
    }

    // Reward Rules
    match /families/{familyId}/rewards/{rewardId} {
      allow read: if true;
      allow create, update, delete: if isSignedIn();
    }

    // Redemption Rules
    match /families/{familyId}/redemptions/{redemptionId} {
      allow read: if true;
      allow create, update: if isSignedIn();
    }

    // Shared Goal Rules
    match /families/{familyId}/shared-goals/{goalId} {
      allow read: if true;
      allow create, update, delete: if isSignedIn();
    }

    // Notification Rules
    match /families/{familyId}/notifications/{notifId} {
      allow read: if true;
      allow create, update: if isSignedIn();
    }
  }
}
